@{
    ViewData["Title"] = "Policy";
}

<!-- internal css: only for this page -->
<style type="text/css">
    /* orange titles for the policy sections */
    .policy-section h3 {
        color: #e8711a;
    }

    /* light orange box with dashed border for the note */
    .policy-note {
        background-color: #fde3cf;
        border: 2px dashed #e8711a;
        border-radius: 8px;
        padding: 10px;
        width: 70%;
    }
</style>

<section id="content" class="content">
    <h2>Rental Policy</h2>
    <p>Please read our rental terms before renting any equipment from Uddah.</p>

    <!-- links that jump to the sections below (they use the section id) -->
    <p>
        Jump to:
        <a href="#rental-period">Rental Period</a> |
        <a href="#deposit">Deposit</a> |
        <a href="#late-return">Late Return</a> |
        <a href="#damage">Damage</a> |
        <a href="#faq">FAQ</a>
    </p>

    <section id="rental-period" class="policy-section">
        <h3>1. Rental Period</h3>
        <ol>
            <li>Equipment is rented by the day (24 hours).</li>
            <li>The rental day starts when you receive the equipment.</li>
            <li>You can extend the rental by contacting us before the end of the day.</li>
        </ol>
    </section>

    <!-- list inside a list (nested) for the parts that must be returned -->
    <section id="deposit" class="policy-section">
        <h3>2. Deposit</h3>
        <p>A refundable deposit is required for every rental. The deposit is returned when:</p>
        <ul>
            <li>The equipment is returned on time.</li>
            <li>The equipment is returned clean and in good condition.</li>
            <li>
                All parts and accessories are included:
                <ul>
                    <li>Batteries and chargers</li>
                    <li>Drill bits and attachments</li>
                    <li>Carrying cases</li>
                </ul>
            </li>
        </ul>
    </section>

    <!-- same table style as the price list in products (price-table class) -->
    <section id="late-return" class="policy-section">
        <h3>3. Late Return</h3>

        <table class="price-table">
            <caption>Late return fees</caption>
            <thead>
                <tr>
                    <th>Delay</th>
                    <th>Fee</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Up to 3 hours</td>
                    <td>No fee</td>
                </tr>
                <tr>
                    <td>3 to 24 hours</td>
                    <td>One extra rental day</td>
                </tr>
                <tr>
                    <td>More than 24 hours</td>
                    <td>One extra day for each day of delay</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section id="damage" class="policy-section">
        <h3>4. Damage and Loss</h3>
        <p>
            The renter is responsible for the equipment during the rental period.
            Repair or replacement costs may be deducted from the deposit.
        </p>

        <!-- policy-note style is in the internal css at the top -->
        <p class="policy-note">
            <strong>Note:</strong> Please report any problem with the equipment
            as soon as you receive it.
        </p>
    </section>

    <!-- FAQ: each answer is hidden at first, the button shows or hides it (javascript) -->
    <section id="faq" class="policy-section">
        <h3>5. Frequently Asked Questions</h3>

        <h4>Can I cancel my rental?</h4>
        <p><button onclick="toggleAnswer('answer1')" class="btn">Show / Hide Answer</button></p>
        <p id="answer1" style="display: none;">
            Yes, you can cancel for free before receiving the equipment.
        </p>

        <h4>Do I need an account to rent?</h4>
        <p><button onclick="toggleAnswer('answer2')" class="btn">Show / Hide Answer</button></p>
        <p id="answer2" style="display: none;">
            Yes, please <a href="/Identity/Account/Register">create an account</a> first.
        </p>

        <h4>How do I contact Uddah?</h4>
        <p><button onclick="toggleAnswer('answer3')" class="btn">Show / Hide Answer</button></p>
        <p id="answer3" style="display: none;">
            Visit our <a asp-controller="Home" asp-action="Contact">Contact Us</a> page.
        </p>
    </section>

    <p><a href="#content">Back to top</a></p>
</section>