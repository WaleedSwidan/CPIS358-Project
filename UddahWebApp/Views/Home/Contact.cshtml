@{
    ViewData["Title"] = "Contact Us";
}

<section id="content" class="content">
    <h2>Contact Us</h2>
    <p>Have a question about renting a tool? We are happy to help.</p>

    <!-- our contact info. the email is a mailto link, it opens the email app -->
    <section id="contact-info">
        <h3>Our Information</h3>
        <ul>
            <li><strong>Location:</strong> Jeddah, Saudi Arabia</li>
            <li><strong>Phone:</strong> 05XXXXXXXX</li>
            <li><strong>Email:</strong> <a href="mailto:info@uddah.com">info@uddah.com</a></li>
            <li><strong>Working Hours:</strong> Saturday to Thursday, 8 AM - 10 PM</li>
        </ul>
    </section>

    <section id="contact-form">
        <h3>Send Us a Message</h3>

        <!-- contact form. form-box gives it the white card style -->
        <!-- onsubmit calls validateContact() from script.js, if it returns false the form is not sent -->
        <form name="contactForm" method="post" action="#" class="form-box" onsubmit="return validateContact()">

            <p>
                <label for="fullName">Full Name:</label>
                <input type="text" id="fullName" name="fullName" size="30" maxlength="50" autofocus>
            </p>

            <p>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder="name@example.com">
            </p>

            <!-- phone is optional, but if the user writes it, it must start with 05 and have 10 digits -->
            <p>
                <label for="phone">Phone:</label>
                <input type="tel" id="phone" name="phone" placeholder="05XXXXXXXX" pattern="05[0-9]{8}">
            </p>

            <p>
                <label for="subject">Subject:</label>
                <select id="subject" name="subject">
                    <option value="general">General Question</option>
                    <option value="rental">Rental Request</option>
                    <option value="return">Return &amp; Deposit</option>
                    <option value="complaint">Complaint</option>
                </select>
            </p>

            <p><label for="message">Message:</label></p>
            <p>
                <textarea id="message" name="message" rows="6" cols="50"></textarea>
            </p>

            <!-- btn is our button class from style.css -->
            <p>
                <input type="submit" value="Send Message" class="btn">
                <input type="reset" value="Clear" class="btn">
            </p>
        </form>

        <!-- inline css here (style inside the tag), only this line is affected -->
        <p style="color: gray; font-size: 10pt; font-style: italic;">
            We usually reply within 24 hours.
        </p>
    </section>
</section>